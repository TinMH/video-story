FROM node:20-alpine

# Thiết lập thư mục làm việc
WORKDIR /app

# Sao chép các file cấu hình dependency
COPY package*.json ./

# Cài đặt toàn bộ dependencies (bao gồm tsx và typescript)
RUN npm install

# Sao chép toàn bộ mã nguồn dự án
COPY . .

# Expose cổng của backend server
EXPOSE 3001

# Biến môi trường mặc định
ENV PORT=3001
ENV NODE_ENV=production

# Khởi chạy Express server bằng tsx tương tự như môi trường dev
CMD ["npx", "tsx", "src/server.ts"]
